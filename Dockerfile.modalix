# Generated Dockerfile for modalix Build:release[2.1.3]

FROM debian:bookworm

ARG BASE_SDK_VERSION=2.1.3
# TEMPORARY PIN -- revert to a release tag ("v0.5.0") once feature/yolox-seg-pose merges.

ARG NEAT_CORE_SPEC=feat/yolox_freeze

# List of additional packages that are to be deployed in SDK sysroot
ARG SDK_PKG_LIST
ENV SDK_PKG_LIST="\
	libgrpc-dev,\
	protobuf-compiler-grpc,\
	python3-pybind11,\
	${SDK_PKG_LIST}"

RUN dpkg --add-architecture arm64
RUN dpkg --add-architecture arc
RUN dpkg --add-architecture armhf
RUN apt-get clean && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y wget pip
RUN wget -qO - https://mirror.elxr.dev/elxr/public.gpg | gpg --dearmor -o /etc/apt/trusted.gpg.d/elxr.gpg
RUN wget -qO - https://packages.fluentbit.io/fluentbit.key | gpg --dearmor > /etc/apt/trusted.gpg.d/fluentbit.gpg
RUN wget --no-check-certificate -O - https://repo.sima.ai/elxr/deb/simaai.gpg | gpg --dearmor > /etc/apt/trusted.gpg.d/simaai.gpg
RUN chmod 644 /etc/apt/trusted.gpg.d/elxr.gpg
RUN chmod 644 /etc/apt/trusted.gpg.d/fluentbit.gpg
RUN chmod 644 /etc/apt/trusted.gpg.d/simaai.gpg

RUN echo "deb [signed-by=/etc/apt/trusted.gpg.d/elxr.gpg] https://mirror.elxr.dev/elxr aria main" > /etc/apt/sources.list.d/elxr.list
RUN echo "deb [signed-by=/etc/apt/trusted.gpg.d/fluentbit.gpg] https://packages.fluentbit.io/debian/bookworm bookworm main" >> /etc/apt/sources.list.d/elxr.list
RUN echo "deb [signed-by=/etc/apt/trusted.gpg.d/simaai.gpg] https://repo.sima.ai/elxr/deb/release bookworm non-free" >> /etc/apt/sources.list.d/elxr.list

RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
	python3-apt-ostree \
	vim \
	make \
	cmake \
	device-tree-compiler \
	bison \
	flex \
	quilt \
	zlib1g-dev \
	bzip2 \
	bc \
	rsync \
	kmod \
	cpio \
	git \
	curl \
	libssl-dev \
	libgnutls28-dev \
	openssh-client \
	simaai-sdk-tools

RUN echo "Package: *" > /etc/apt/preferences.d/stable.pref
RUN echo "Pin: origin \"repo.sima.ai/elxr\"" >> /etc/apt/preferences.d/stable.pref
RUN echo "Pin-Priority: 999" >> /etc/apt/preferences.d/stable.pref

COPY --chmod=0755 scripts/install-ros2.sh /usr/local/bin/install-ros2
RUN /usr/local/bin/install-ros2

# Build dependencies of the sima application code that compiles against this SDK, as
# opposed to dependencies of the SDK itself. Application repos (stiga, and any other
# client) were each installing these at CI time; they belong here so every consumer of
# the image gets them without repeating the list.
#
# liborocos-kdl-dev is the one that is not optional: orocos_kdl_vendor ships INSIDE the
# ros2 deb and its CMake config does find_package(orocos_kdl), which resolves to this
# package's /usr/lib/*/cmake/orocos_kdl/orocos_kdl-config.cmake. Without it, every
# package that pulls in tf2_geometry_msgs fails at configure. Strictly this belongs in
# the ros2 deb's runtime-depends -- the deb ships a package config it cannot satisfy --
# but installing it here fixes every consumer today.
#
# git-lfs is for application repos whose model archives are LFS objects; nothing in the
# SDK itself needs it.
#
# NOT simaai-socpipeline-dev: it ships /usr/include/configFunctions.h, which is also in
# neat-internals-dev installed by install-neat-core below. dpkg aborts on the overwrite.
# The headers it would provide are all present via neat-internals-dev, so it is
# superseded here rather than missing.
RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        nlohmann-json3-dev \
        rapidjson-dev \
        libgdal-dev \
        liborocos-kdl-dev \
        git-lfs \
        simaai-memory-lib-dev \
        libjsoncpp-dev \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev && \
    git lfs install --system && \
    rm -rf /var/lib/apt/lists/*

# Build-time python imports of the sima source. --break-system-packages because bookworm
# marks the system interpreter EXTERNALLY-MANAGED; this image has no venv by design, the
# ROS 2 install being system-wide already.
#
# shapely and pyclipper are deliberately absent: those are application runtime deps that
# get vendored into an application's own install tree, not built against here.
RUN pip3 install --break-system-packages --no-cache-dir \
        pydantic \
        py_trees \
        xacro

RUN export RUSTUP_HOME=/opt/toolchain/rust && export CARGO_HOME=/opt/toolchain/rust && \
    mkdir -p ${RUSTUP_HOME} && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs > /tmp/rustup.sh && \
    chmod 755 /tmp/rustup.sh && /tmp/rustup.sh -y && \
    echo "export RUSTUP_HOME=${RUSTUP_HOME}" >> ${CARGO_HOME}/env && \
    echo "export CARGO_HOME=${CARGO_HOME}" >> ${CARGO_HOME}/env && \
    . ${CARGO_HOME}/env && rm /tmp/rustup.sh

RUN if uname -a | grep -q '#[0-9]*-Ubuntu'; then \
        apt-get update --allow-releaseinfo-change; \
        --privileged mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc || true; \
    fi

RUN if [ "x86_64" = "x86_64" ]; then apt update --allow-releaseinfo-change && apt install \
    arch-test -y; fi

RUN python3 /opt/bin/simaai_setup_sdk.py modalix "${BASE_SDK_VERSION}" \
	 \
	"${SDK_PKG_LIST}"

COPY --chmod=0755 scripts/install-realsense.sh /usr/local/bin/install-realsense
RUN /usr/local/bin/install-realsense

COPY --chmod=0755 scripts/install-sima-cli.sh /usr/local/bin/install-sima-cli
RUN /usr/local/bin/install-sima-cli

# The Neat package installer uses this marker to validate the native ROS 2 SDK
# platform before installing the runtime and development Debian packages.
RUN printf 'SDK Type = ros2-sdk\nPlatform Version = %s\nPlatform Base = %s\n' \
        "${BASE_SDK_VERSION}" "${BASE_SDK_VERSION}" > /etc/sdk-release
COPY --chmod=0755 scripts/install-neat-core.sh /usr/local/bin/install-neat-core
RUN NEAT_CORE_SPEC="${NEAT_CORE_SPEC}" /usr/local/bin/install-neat-core

COPY --chmod=0755 scripts/install-github-tools.sh /usr/local/bin/install-github-tools
RUN /usr/local/bin/install-github-tools

COPY --chmod=0755 scripts/setup-native-build-env.sh /usr/local/bin/setup-native-build-env
COPY --chmod=0644 scripts/setup-shell-env.sh /etc/profile.d/ros2-sdk.sh
RUN bash -c 'source /etc/profile.d/ros2-sdk.sh && \
    test "$(gcc -dumpmachine)" = "aarch64-linux-gnu" && \
    [[ "${CFLAGS}" != *--sysroot* ]] && \
    [[ ":${CMAKE_PREFIX_PATH}:" == *:/usr/local/ros2/ament_cmake:* ]]'

RUN echo "source /etc/profile.d/ros2-sdk.sh" >> /etc/bash.bashrc

ARG SDK_PRODUCT_NAME="SiMa.ai ROS2 SDK"
ARG SDK_RELEASE_TAG=""
ARG SDK_GIT_BRANCH="unknown"
ARG SDK_GIT_HASH="nogit"
ARG SDK_BUILD_TIME="unknown-time"
ARG SDK_TYPE="ros2-sdk"
ARG SDK_PROFILE="native-arm64"
ARG PLATFORM_CHANNEL="release"
ARG PLATFORM_REPOSITORY="https://repo.sima.ai/elxr/deb/release"
COPY --chmod=0755 scripts/write-sdk-release.sh /usr/local/bin/write-sdk-release
# NEAT_CORE_VERSION is read back from dpkg, not passed in: the spec above is a ref, and the
# version it resolves to is only knowable after the install. Deriving it here means
# /etc/sdk-release always reports what is actually installed -- which is what gen_release.sh
# stamps into a release packet and what provision.sh checks the rover against.
RUN NEAT_CORE_VERSION="$(dpkg-query -W -f='${Version}' sima-neat)" && \
    SDK_TYPE="${SDK_TYPE}" \
    SDK_PROFILE="${SDK_PROFILE}" \
    PLATFORM_VERSION="${BASE_SDK_VERSION}" \
    NEAT_CORE_VERSION="${NEAT_CORE_VERSION}" \
    NEAT_CORE_SPEC="${NEAT_CORE_SPEC}" \
    PLATFORM_CHANNEL="${PLATFORM_CHANNEL}" \
    PLATFORM_REPOSITORY="${PLATFORM_REPOSITORY}" \
    /usr/local/bin/write-sdk-release \
        /etc/sdk-release \
        "${SDK_PRODUCT_NAME}" \
        "${SDK_RELEASE_TAG}" \
        "${SDK_GIT_BRANCH}" \
        "${SDK_GIT_HASH}" \
        "${SDK_BUILD_TIME}" && \
    grep -Fxq "Product Name = ${SDK_PRODUCT_NAME}" /etc/sdk-release && \
    grep -Fxq "SDK Type = ${SDK_TYPE}" /etc/sdk-release && \
    grep -Fxq "Platform Version = ${BASE_SDK_VERSION}" /etc/sdk-release && \
    grep -Fxq "Neat Core = ${NEAT_CORE_VERSION}" /etc/sdk-release && \
    _spec="$(sed -n 's/^Neat Core Spec = //p' /etc/sdk-release)" && \
    case "${_spec}" in "${NEAT_CORE_SPEC}"|"${NEAT_CORE_SPEC}":*) ;; \
      *) echo "Neat Core Spec is '${_spec}', expected '${NEAT_CORE_SPEC}' or it with a :sha" >&2; exit 1 ;; esac
