# ROS 2 SDK for the platform 3.0 line: eLxr bianca (Debian 13), native arm64.
# The apt source, keys and sysroot call follow the generated 3.0 eLxr SDK
# Dockerfile (Build:daily[...-1774]); everything else is this repo's layout.

FROM elxrlinux/elxr:bianca-26.04.02

ARG BASE_SDK_VERSION=3.0.0
# develop is the platform 3.0.0 line (Neat 0.6.0, ABI 6). release-0.6-ea was cut
# before feature/yolox-seg-pose merged and cannot decode yolox-seg-pose archives.
ARG NEAT_CORE_SPEC=develop:8b9a54467791

# Daily platform channel. The internal host carries every daily build, signed;
# the public mirror (https://debian.neat.sima.ai/daily, unsigned, trusted=yes)
# lags it by weeks. Build on VPN.
ARG PLATFORM_CHANNEL=daily
ARG PLATFORM_REPOSITORY=http://sw-web.eng.sima.ai/deb/daily
ARG PLATFORM_ORIGIN=sw-web.eng.sima.ai
# The daily build flashed on the DevKits, which must be the one the Neat ref's
# internals snapshot targets (its EV74 firmware activates only on that exact
# kernel build). Every platform package the image installs, and the sysroot
# below, are pinned to it so image and board agree; the channel itself carries
# dozens of builds and a bare "3.0.0" matches none.
ARG PLATFORM_BUILD=2038
ARG PALETTE_BUILD="3.0.0~git*-${PLATFORM_BUILD}"
ARG LIBC_DEV_VERSION="6.18.3-${PLATFORM_BUILD}"
# The cross sysroot under /opt/toolchain is ~6 GB and no native build needs
# it; SKIP_SYSROOT=1 leaves it out.
ARG SKIP_SYSROOT=0
ARG WITH_REALSENSE=1
# Build-context directory holding the trixie ros2 deb (see install-ros2.sh).
ARG ROS2_DEB_SRC=vendor

# List of additional packages that are to be deployed in SDK sysroot
ARG SDK_PKG_LIST
ENV SDK_PKG_LIST="\
	libgrpc-dev,\
	protobuf-compiler-grpc,\
	python3-pybind11,\
	${SDK_PKG_LIST}"

RUN dpkg --add-architecture arm64
RUN apt-get clean && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y apt-utils wget pip gnupg ca-certificates
RUN wget --no-check-certificate -O - http://sw-web.eng.sima.ai/deb/simaai.gpg | gpg --dearmor > /etc/apt/trusted.gpg.d/simaai.gpg
# The daily suites are signed with the release key (4F87A7B80CFC8F4B), which
# sw-web's own simaai.gpg does not carry -- only repo.sima.ai's does. Append it
# or apt refuses the suite as unsigned (SOCSW-6003).
RUN wget --no-check-certificate -O - https://repo.sima.ai/elxr/deb/simaai.gpg | gpg --dearmor >> /etc/apt/trusted.gpg.d/simaai.gpg
RUN chmod 644 /etc/apt/trusted.gpg.d/simaai.gpg

RUN echo "deb [signed-by=/etc/apt/trusted.gpg.d/simaai.gpg] ${PLATFORM_REPOSITORY} agate non-free" > /etc/apt/sources.list.d/simaai.list

# Platform packages win over eLxr's own (kernel headers, libcamera, ...), as on
# the board, and within the channel the DevKit build wins over newer dailies.
# apt rejects a version pin on "Package: *", hence the explicit name globs.
RUN printf 'Package: *\nPin: origin "%s"\nPin-Priority: 999\n\nPackage: simaai-* linux-libc-dev linux-headers-* a65apps cvu-sw libcamera* tvm python3-tvm swsoc-* smifb-* lttng-modules-*\nPin: version *-%s\nPin-Priority: 1001\n' \
        "${PLATFORM_ORIGIN}" "${PLATFORM_BUILD}" > /etc/apt/preferences.d/stable.pref

RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
	python3-apt-ostree \
	vim \
	make \
	cmake \
	device-tree-compiler \
	bison \
	flex \
	quilt \
	zlib1g-dev \
	bzip2 \
	bc \
	rsync \
	kmod \
	cpio \
	git \
	curl \
	libssl-dev \
	libgnutls28-dev \
	openssh-client \
	simaai-sdk-tools

COPY ${ROS2_DEB_SRC}/ros2_*_arm64.deb /tmp/ros2-deb/
COPY --chmod=0755 scripts/install-ros2.sh /usr/local/bin/install-ros2
RUN /usr/local/bin/install-ros2

# Build dependencies of the sima application code that compiles against this SDK, as
# opposed to dependencies of the SDK itself. Application repos (stiga, and any other
# client) were each installing these at CI time; they belong here so every consumer of
# the image gets them without repeating the list.
#
# liborocos-kdl-dev is the one that is not optional: orocos_kdl_vendor ships INSIDE the
# ros2 deb and its CMake config does find_package(orocos_kdl), which resolves to this
# package's /usr/lib/*/cmake/orocos_kdl/orocos_kdl-config.cmake. Without it, every
# package that pulls in tf2_geometry_msgs fails at configure. Strictly this belongs in
# the ros2 deb's runtime-depends -- the deb ships a package config it cannot satisfy --
# but installing it here fixes every consumer today.
#
# git-lfs is for application repos whose model archives are LFS objects; nothing in the
# SDK itself needs it.
#
# simaai-socpipeline-dev is still left out: nothing built against this image needs
# it (the neat-internals-dev header clash that first excluded it is gone with 0.6).
#
# tvm: the Neat installer requires libtvm_runtime.so on the native linker path and
# otherwise copies it out of the cross sysroot, which SKIP_SYSROOT=1 leaves out.
RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        nlohmann-json3-dev \
        libgdal-dev \
        liborocos-kdl-dev \
        git-lfs \
        simaai-memory-lib-dev \
        tvm \
        libjsoncpp-dev \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev && \
    git lfs install --system && \
    rm -rf /var/lib/apt/lists/*

# Build-time python imports of the sima source. pydantic comes from apt: the pip
# release wants a newer typing_extensions than the Debian one the ros2 deb pulls
# in, and pip cannot replace a Debian-owned package. py_trees and xacro have no
# Debian package; --break-system-packages because the system interpreter is
# EXTERNALLY-MANAGED and this image has no venv by design, the ROS 2 install
# being system-wide already.
#
# shapely and pyclipper are deliberately absent: those are application runtime deps that
# get vendored into an application's own install tree, not built against here.
RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends python3-pydantic && \
    rm -rf /var/lib/apt/lists/* && \
    pip3 install --break-system-packages --no-cache-dir \
        py_trees \
        xacro

RUN export RUSTUP_HOME=/opt/toolchain/rust && export CARGO_HOME=/opt/toolchain/rust && \
    mkdir -p ${RUSTUP_HOME} && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs > /tmp/rustup.sh && \
    chmod 755 /tmp/rustup.sh && /tmp/rustup.sh -y && \
    echo "export RUSTUP_HOME=${RUSTUP_HOME}" >> ${CARGO_HOME}/env && \
    echo "export CARGO_HOME=${CARGO_HOME}" >> ${CARGO_HOME}/env && \
    . ${CARGO_HOME}/env && rm /tmp/rustup.sh

RUN if uname -a | grep -q '#[0-9]*-Ubuntu'; then \
        apt-get update --allow-releaseinfo-change; \
        --privileged mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc || true; \
    fi

# Arguments: platform, palette version glob, linux-libc-dev version, extra packages.
RUN if [ "${SKIP_SYSROOT}" = "1" ]; then echo "SKIP_SYSROOT=1: no cross sysroot"; else \
        python3 /opt/bin/simaai_setup_sdk.py modalix "${PALETTE_BUILD}" \
            "${LIBC_DEV_VERSION}" \
            "${SDK_PKG_LIST}"; fi

COPY --chmod=0755 scripts/install-realsense.sh /usr/local/bin/install-realsense
RUN if [ "${WITH_REALSENSE}" = "1" ]; then /usr/local/bin/install-realsense; else echo "WITH_REALSENSE=0: skipped"; fi

COPY --chmod=0755 scripts/install-sima-cli.sh /usr/local/bin/install-sima-cli
RUN /usr/local/bin/install-sima-cli

# The Neat package installer uses this marker to validate the native ROS 2 SDK
# platform before installing the runtime and development Debian packages.
RUN printf 'SDK Type = ros2-sdk\nPlatform Version = %s\nPlatform Base = %s\n' \
        "${BASE_SDK_VERSION}" "${BASE_SDK_VERSION}" > /etc/sdk-release
COPY --chmod=0755 scripts/install-neat-core.sh /usr/local/bin/install-neat-core
RUN NEAT_CORE_SPEC="${NEAT_CORE_SPEC}" /usr/local/bin/install-neat-core

COPY --chmod=0755 scripts/install-github-tools.sh /usr/local/bin/install-github-tools
RUN /usr/local/bin/install-github-tools

COPY --chmod=0755 scripts/setup-native-build-env.sh /usr/local/bin/setup-native-build-env
COPY --chmod=0644 scripts/setup-shell-env.sh /etc/profile.d/ros2-sdk.sh
RUN bash -c 'source /etc/profile.d/ros2-sdk.sh && \
    test "$(gcc -dumpmachine)" = "aarch64-linux-gnu" && \
    [[ "${CFLAGS}" != *--sysroot* ]] && \
    [[ ":${CMAKE_PREFIX_PATH}:" == *:/usr/local/ros2/ament_cmake:* ]]'

RUN echo "source /etc/profile.d/ros2-sdk.sh" >> /etc/bash.bashrc

ARG SDK_PRODUCT_NAME="SiMa.ai ROS2 SDK"
ARG SDK_RELEASE_TAG=""
ARG SDK_GIT_BRANCH="unknown"
ARG SDK_GIT_HASH="nogit"
ARG SDK_BUILD_TIME="unknown-time"
ARG SDK_TYPE="ros2-sdk"
ARG SDK_PROFILE="native-arm64"
COPY --chmod=0755 scripts/write-sdk-release.sh /usr/local/bin/write-sdk-release
# NEAT_CORE_VERSION is read back from dpkg, not passed in: the spec above is a ref, and the
# version it resolves to is only knowable after the install. Deriving it here means
# /etc/sdk-release always reports what is actually installed -- which is what gen_release.sh
# stamps into a release packet and what provision.sh checks the rover against.
RUN NEAT_CORE_VERSION="$(dpkg-query -W -f='${Version}' sima-neat)" && \
    SDK_TYPE="${SDK_TYPE}" \
    SDK_PROFILE="${SDK_PROFILE}" \
    PLATFORM_VERSION="${BASE_SDK_VERSION}" \
    NEAT_CORE_VERSION="${NEAT_CORE_VERSION}" \
    NEAT_CORE_SPEC="${NEAT_CORE_SPEC}" \
    PLATFORM_CHANNEL="${PLATFORM_CHANNEL}" \
    PLATFORM_REPOSITORY="${PLATFORM_REPOSITORY}" \
    /usr/local/bin/write-sdk-release \
        /etc/sdk-release \
        "${SDK_PRODUCT_NAME}" \
        "${SDK_RELEASE_TAG}" \
        "${SDK_GIT_BRANCH}" \
        "${SDK_GIT_HASH}" \
        "${SDK_BUILD_TIME}" && \
    grep -Fxq "Product Name = ${SDK_PRODUCT_NAME}" /etc/sdk-release && \
    grep -Fxq "SDK Type = ${SDK_TYPE}" /etc/sdk-release && \
    grep -Fxq "Platform Version = ${BASE_SDK_VERSION}" /etc/sdk-release && \
    grep -Fxq "Neat Core = ${NEAT_CORE_VERSION}" /etc/sdk-release && \
    _spec="$(sed -n 's/^Neat Core Spec = //p' /etc/sdk-release)" && \
    case "${_spec}" in "${NEAT_CORE_SPEC}"|"${NEAT_CORE_SPEC}":*) ;; \
      *) echo "Neat Core Spec is '${_spec}', expected '${NEAT_CORE_SPEC}' or it with a :sha" >&2; exit 1 ;; esac
